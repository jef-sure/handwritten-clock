# Guition JC1060P470: ESP32-P4, 16 MB flash, 32 MB PSRAM, JD9165 1024x600 on MIPI-DSI,
# Wi-Fi and BLE in an ESP32-C6 beside it
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_DGX_ENABLE_DSI=y
CONFIG_DGX_ENABLE_JD9165=y

# The frame buffer the display is sent from lives in PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# Drawing goes through the cache of the PSRAM: a larger one makes it faster and takes internal RAM
CONFIG_CACHE_L2_CACHE_256KB=y

# The board this was made on has a chip of revision 1.3.
# Remove the line for a chip of revision 3.0 or later.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# Wi-Fi and BLE are in the ESP32-C6 of the board, behind SDIO: its pins are the ones
# esp_hosted has by default, CLK 18, CMD 19, D0-D3 14-17, reset 54.
# The Bluetooth controller is there too, the NimBLE stack here talks to it through esp_hosted.
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
