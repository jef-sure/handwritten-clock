# CYD: ESP32, 4 MB flash, ILI9341 320x240 on SPI
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# one application, no OTA
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_DGX_ENABLE_SPI=y
CONFIG_DGX_ENABLE_SPI_ILI_9341=y
CONFIG_DGX_ENABLE_VSCREEN=y
CONFIG_DGX_ENABLE_MORPH=y

# Wi-Fi is set up over BLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# the phone proves it has read the QR code: security 1, which IDF 6 no longer has on by default
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
